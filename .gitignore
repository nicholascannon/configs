.DS_Store

# Per-machine Neovim overrides (e.g. enabling Copilot where a seat exists)
packages/nvim/.config/nvim/local.lua

# Work-org-synced Claude skills (machine-local, not dotfiles)
packages/claude/.claude/skills/synced/

# omp's config-write lock: runtime state, recreated on demand
packages/omp/.omp/agent/config.yml.lock

