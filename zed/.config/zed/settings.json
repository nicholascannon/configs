// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // Editor / UI
  "autosave": "on_focus_change",
  "base_keymap": "Cursor",
  "buffer_font_family": ".ZedMono",
  "buffer_font_size": 12.0,
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "file_scan_inclusions": [".env", ".env.*", "docs/superpowers/*"],
  "format_on_save": "on",
  "icon_theme": "Material Icon Theme",
  "markdown_preview_font_size": 14.0,
  "theme": "Aero",
  "ui_font_size": 14.0,
  "vim_mode": true,

  // Extensions
  "auto_install_extensions": {
    "fleet-themes": true,
    "git-firefly": true,
    "html": true,
    "material-icon-theme": true,
    "postgres-language-server": true,
    "prisma": true,
    "sql": true,
    "terraform": true,
    "toml": true,
  },

  // Panels
  "project_panel": {
    "auto_fold_dirs": false,
    "dock": "left",
    "entry_spacing": "standard",
    "indent_size": 12,
  },
  "git_panel": {
    "dock": "left",
    "entry_primary_click_action": "file_diff",
    "file_icons": true,
    "group_by": "staging",
    "tree_view": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },

  // Agent
  "agent": {
    "commit_message_instructions": "Use Conventional Commits format: <type>(<scope>): <subject>. Types: feat, fix, refactor, chore, docs, test, style, perf. Keep the subject line under 72 characters, lowercase, no trailing period. Add a body only if the change needs more explanation.",
    "commit_message_model": {
      "speed": "fast",

      // personal machine
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",

      // work machine
      // "provider": "copilot_chat",
      // "model": "gpt-4.1-mini"
    },
    "default_model": {
      "enable_thinking": true,

      // personal machine
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",

      // work machine
      // "effort": "high",
      // "provider": "copilot_chat",
      // "model": "gpt-5.3-codex",
    },
    "dock": "right",
    "notify_when_agent_waiting": "all_screens",
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "thinking_display": "preview",

    // Auto-approve all tool actions (no confirmation prompts — "auto mode").
    // NOTE: global — applies to every profile, not just the default. Built-in
    // security rules (rm -rf /, ~, ...) and always_deny/always_confirm
    // patterns still apply.
    "tool_permissions": {
      "default": "allow",
    },
  },

  "edit_predictions": {
    // personal machine
    "provider": "zed",

    // work machine
    // "provider": "copilot",
  },

  // Languages
  "languages": {
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
    },
  },

  // For eslint projects, drop this in project .zed/settings.json instead
  // (formatter: [] stops biome clobbering eslint's fixAll):
  // "languages": {
  //   "JavaScript": {
  //     "formatter": [],
  //     "code_actions_on_format": {
  //       "source.fixAll.eslint": true
  //     }
  //   },
  //   "TypeScript": {
  //     "formatter": [],
  //     "code_actions_on_format": {
  //       "source.fixAll.eslint": true
  //     }
  //   },
  //   "TSX": {
  //     "formatter": [],
  //     "code_actions_on_format": {
  //       "source.fixAll.eslint": true
  //     }
  //   }
  // },

  // Terminal
  "terminal": {
    "env": {
      "EDITOR": "zed --wait",
    },
    "font_family": "MesloLGL Nerd Font",
  },

  // LSP
  "lsp": {
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
    },
  },

  // Telemetry
  "telemetry": {
    "metrics": false,
  },
}
