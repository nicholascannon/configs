// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // Editor / UI
  "base_keymap": "Cursor",
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "vim_mode": true,
  "theme": "Fleet Dark",
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "Menlo",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "markdown_preview_font_size": 14.0,
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "restore_on_startup": "last_session",
  "file_scan_inclusions": [
    ".env",
    ".env.*",
    "docs/superpowers/*",
    ".superpowers/*",
  ],

  // Extensions
  "auto_install_extensions": {
    "html": true,
    "toml": true,
    "fleet-themes": true,
    "material-icon-theme": true,
    "git-firefly": true,
    "postgres-language-server": true,
    "prisma": true,
    "sql": true,
    "terraform": true,
  },

  // Panels
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard",
    "indent_size": 12,
    "auto_fold_dirs": false,
  },
  "git_panel": {
    "group_by": "none",
    "tree_view": true,
    "dock": "left",
    "entry_primary_click_action": "file_diff",
    "file_icons": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },

  // Git
  "git": {
    // Ships in v1.13.0-pre / future stable
    // "file_diff": {
    //     "show_full_file": true
    // }
  },

  // Agent
  "agent": {
    "dock": "right",
    "notify_when_agent_waiting": "all_screens",
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "auto_compact": {
      "enabled": true,
      "threshold": "90%",
    },
    "default_model": {
      "enable_thinking": true,

      // personal machine
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-pro",

      // work machine
      // "effort": "high",
      // "provider": "copilot_chat",
      // "model": "gpt-5.3-codex",
    },
    "commit_message_model": {
      "speed": "fast",

      // personal machine
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",

      // work machine
      // "provider": "copilot_chat",
      // "model": "gpt-4.1-mini"
    },
    "commit_message_instructions": "Use Conventional Commits format: <type>(<scope>): <subject>. Types: feat, fix, refactor, chore, docs, test, style, perf. Keep the subject line under 72 characters, lowercase, no trailing period. Add a body only if the change needs more explanation.",
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^rg(\\s|$)" },
            {
              "pattern": "^git\\s+(status|log|diff|show|branch|blame|remote|stash\\s+list|tag|describe)(\\s|$)",
            },
            {
              "pattern": "^gh\\s+(pr|issue|repo|run|workflow|release|search|status)(\\s|$)",
            },
            { "pattern": "^(ls|cat|head|tail|pwd|which|echo|mkdir|touch)\\b" },
            {
              "pattern": "^(npm|pnpm|yarn|bun|cargo|make)\\s+(test|run|build|check|lint|fmt|typecheck)(\\s|$)",
            },
          ],
          "always_confirm": [
            { "pattern": "\\bgit\\s+push\\b" },
            { "pattern": "\\bsudo\\b" },
            { "pattern": "\\brm\\b" },
            { "pattern": "\\bcurl\\b|\\bwget\\b" },
            {
              "pattern": "\\bnpx\\b|\\bnpm\\s+install\\b|\\bbrew\\s+install\\b",
            },
            {
              "pattern": "gh\\s+(pr\\s+(merge|create|close|reopen)|repo\\s+(delete|create)|issue\\s+(create|close|reopen))\\b",
            },
          ],
          "always_deny": [{ "pattern": "rm\\s+-rf\\s+(/|~|\\$HOME)" }],
        },
        "edit_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "\\.env" },
            { "pattern": "\\.(pem|key|p12)$" },
            { "pattern": "secrets?/" },
            { "pattern": "\\.ssh/" },
          ],
        },
        "write_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "\\.env" },
            { "pattern": "\\.(pem|key|p12)$" },
          ],
        },
        "delete_path": {
          "default": "confirm",
          "always_deny": [
            { "pattern": "\\.git/?$" },
            { "pattern": "node_modules/?$" },
          ],
        },
        "fetch": { "default": "confirm" },
        "move_path": { "default": "confirm" },
        "copy_path": { "default": "confirm" },
        "create_directory": { "default": "allow" },
      },
    },
  },
  "edit_predictions": {
    // personal machine
    "provider": "zed",

    // work machine
    // "provider": "copilot",
  },

  // Languages
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
    },
  },

  // For eslint projects, drop this in project .zed/settings.json instead
  // (formatter: [] stops biome clobbering eslint's fixAll):
  // "languages": {
  //   "JavaScript": {
  //     "formatter": [],
  //     "code_actions_on_format": {
  //       "source.fixAll.eslint": true
  //     }
  //   },
  //   "TypeScript": {
  //     "formatter": [],
  //     "code_actions_on_format": {
  //       "source.fixAll.eslint": true
  //     }
  //   },
  //   "TSX": {
  //     "formatter": [],
  //     "code_actions_on_format": {
  //       "source.fixAll.eslint": true
  //     }
  //   }
  // },

  // Terminal
  "terminal": {
    "font_family": "MesloLGL Nerd Font",
    "env": {
      "EDITOR": "zed --wait",
    },
  },

  // LSP
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },

  // Telemetry
  "telemetry": {
    "metrics": false,
  },
}
