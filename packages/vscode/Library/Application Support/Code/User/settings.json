{
  /* WINDOW AND WORKBENCH */
  "window.restoreWindows": "none",
  "window.commandCenter": false,
  "workbench.colorTheme": "Aero",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "welcomePageInEmptyWorkbench",
  "workbench.tips.enabled": false,
  "breadcrumbs.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",

  /* EDITOR */
  "editor.fontSize": 13,
  "editor.tabSize": 2,
  "editor.cursorSurroundingLines": 10,
  "editor.minimap.enabled": false,
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.lightbulb.enabled": "off",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },

  /* MARKDOWN */
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor",
  },

  /* DIFF EDITOR */
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,

  /* EXPLORER */
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,

  /* TERMINAL */
  "terminal.integrated.fontFamily": "MesloLGL Nerd Font",
  "terminal.integrated.fontSize": 13,

  /* GIT */
  "git.confirmSync": false,
  "git.blame.editorDecoration.enabled": true,
  "githubPullRequests.pullBranch": "always",

  /* AI */
  // Copilot stays on only for commit message generation; AI otherwise runs via the CLI.
  "github.copilot.enable": { "*": false },
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits format: <type>(<scope>): <subject>. Types: feat, fix, refactor, chore, docs, test, style, perf. Keep the subject line under 72 characters, lowercase, no trailing period. Add a body only if the change needs more explanation.",
    },
  ],
  "chat.titleBar.openInAgentsWindow.enabled": false,

  /* PROMPTS AND TELEMETRY */
  "extensions.ignoreRecommendations": true,
  "update.showReleaseNotes": false,
  "telemetry.telemetryLevel": "off",

  /* JSON */
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true,
  },

  /* TERRAFORM */
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.formatAll.terraform": "explicit",
    },
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
  },
  "terraform.experimentalFeatures.validateOnSave": true,

  /* ICON THEME */
  "material-icon-theme.hidesExplorerArrows": true,
  "material-icon-theme.folders.color": "#fdd835",

  /* CLAUDE CODE */
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,

  /* VIM */
  "vim.hlsearch": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["K"],
      "commands": [{ "command": "editor.action.showHover" }],
    },
    {
      "before": ["<leader>", "f", "\n"],
      "commands": [{ "command": "editor.action.formatDocument" }],
    },
    {
      "before": ["<leader>", "a", "\n"],
      "commands": [
        {
          "command": "editor.action.quickFix",
          "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly",
        },
      ],
    },
    {
      "before": ["<leader>", "r", "n"],
      "commands": [{ "command": "editor.action.rename" }],
    },
    {
      "before": ["g", "r"],
      "commands": [{ "command": "editor.action.goToReferences" }],
    },
    {
      "before": ["g", "i"],
      "commands": [{ "command": "editor.action.goToImplementation" }],
    },
    {
      "before": ["g", "p"],
      "commands": [{ "command": "editor.action.peekDefinition" }],
    },
  ],
}
