  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#666672" } },
    { "scope": ["comment.block.documentation", "comment.block.javadoc"], "settings": { "foreground": "#75758a" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "#5cc191" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#4cc2bc" } },
    { "scope": ["constant", "constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#e0ab4f" } },
    { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.other"], "settings": { "foreground": "#b483e8" } },
    { "scope": ["keyword.operator", "keyword.operator.assignment"], "settings": { "foreground": "#a8a8b3" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#b483e8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#3898e0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace"], "settings": { "foreground": "#3898e0" } },
    { "scope": ["variable", "variable.other", "variable.other.property", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#e2e2e2" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#c9a8ec" } },
    { "scope": ["variable.language", "support.variable"], "settings": { "foreground": "#e0ab4f" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#8a8a95" } },
    { "scope": ["punctuation.definition.string", "punctuation.definition.template-expression"], "settings": { "foreground": "#5cc191" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#f07686" } },
    { "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#e0ab4f" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#3898e0" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#3898e0", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#3898e0" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#3fa372" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e0556e" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#c79334" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e0556e" } }
  ],
  "semanticTokenColors": {
    "function": "#3898e0",
    "method": "#3898e0",
    "type": "#3898e0",
    "class": "#3898e0",
    "interface": "#3898e0",
    "enum": "#3898e0",
    "namespace": "#3898e0",
    "typeParameter": "#3898e0",
    "parameter": "#c9a8ec",
    "variable": "#e2e2e2",
    "property": "#e2e2e2",
    "enumMember": "#e0ab4f",
    "variable.readonly.defaultLibrary": "#e0ab4f",
    "keyword": "#b483e8",
    "decorator": "#e0ab4f",
    "string": "#5cc191",
    "number": "#e0ab4f",
    "regexp": "#4cc2bc",
    "comment": "#666672",
    "*.documentation": "#75758a"
  }
}
