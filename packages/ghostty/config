theme = Brogrammer
font-family = "MesloLGS Nerd Font Mono"

split-divider-color = #f0f0f0

# Thicker glyph strokes: thin anti-aliased edges pick up tinted backgrounds
# (e.g. nvim diff lines) and make syntax colors look shifted.
font-thicken = true

scrollback-limit = 100000000

window-inherit-working-directory = false
window-width = 128
window-height = 45
