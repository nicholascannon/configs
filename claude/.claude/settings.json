{
  "env": {
    "EDITOR": "cursor"
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "/Users/nicholas/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "allow": [
      "Read",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(jq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(file *)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(uname *)",
      "Bash(sw_vers)"
    ]
  }
}
