{
  "env": {
    "EDITOR": "zed --wait"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(rg *)",
      "LSP",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch --list*)",
      "Bash(git blame *)",
      "Bash(git remote -v*)",
      "Bash(git stash list*)",
      "Bash(git tag --list*)",
      "Bash(git describe*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status*)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh search *)",
      "Bash(gh status*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(git remote get-url *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "opus": {
      "effortLevel": "high"
    },
    "sonnet": {
      "effortLevel": "medium"
    }
  },
  "editorMode": "vim",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
